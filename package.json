{
  "name": "@uni-helper/vite-plugin-uni-middleware",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "warn"
    }
  },
  "description": "Use route middleware in uni-app with Vite.",
  "author": "KeJun",
  "license": "MIT",
  "homepage": "https://github.com/uni-helper/vite-plugin-uni-middleware#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/vite-plugin-uni-middleware.git"
  },
  "bugs": "https://github.com/uni-helper/vite-plugin-uni-middleware/issues",
  "keywords": [
    "uni-app",
    "vite-plugin",
    "middleware",
    "route"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime/index.d.mts",
        "default": "./dist/runtime/index.mjs"
      }
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "client.d.ts",
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:play:h5": "pnpm -C playground run build:h5",
    "dev:play:h5": "pnpm -C playground run dev:h5",
    "build:play:mp-weixin": "pnpm -C playground run build:mp-weixin",
    "dev:play:mp-weixin": "pnpm -C playground run dev:mp-weixin",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "release": "bumpp"
  },
  "peerDependencies": {
    "vite": "^5.0.0",
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "jsonc-parser": "catalog:",
    "scule": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@dcloudio/types": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
